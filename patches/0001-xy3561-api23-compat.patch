index 0000000000000000000000000000000000000000..b8325478dcf9b1a570f02706518c0572fa9f5566
--- /dev/null
+++ b/common/src/test/java/com/shilapi/xcertplay/Api23UiCompatTest.kt
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+package com.shilapi.xcertplay
+
+import android.content.res.Configuration
+import android.graphics.drawable.GradientDrawable
+import java.util.Locale
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [23])
+class Api23UiCompatTest {
+    @Test fun localeAndPortraitDensityDoNotNeedLocaleList() {
+        val source = Configuration().apply {
+            setLocale(Locale.SIMPLIFIED_CHINESE)
+            densityDpi = 160
+            screenWidthDp = 768
+            screenHeightDp = 1024
+            smallestScreenWidthDp = 768
+        }
+        assertEquals(Locale.SIMPLIFIED_CHINESE, Api23UiCompat.firstLocale(source))
+        val target = Configuration()
+        Api23UiCompat.copyLocales(target, source)
+        assertEquals(Locale.SIMPLIFIED_CHINESE, Api23UiCompat.firstLocale(target))
+        val scaled = requireNotNull(InterfaceSize.override(source, 125))
+        assertTrue(scaled.screenHeightDp > scaled.screenWidthDp)
+        assertEquals(Locale.SIMPLIFIED_CHINESE, Api23UiCompat.firstLocale(scaled))
+        assertEquals(Locale.SIMPLIFIED_CHINESE,
+            Api23UiCompat.firstLocale(InterfaceSize.contextOverride(scaled)))
+    }
+
+    @Test fun roundedFocusBorderUsesStoredRadius() {
+        val drawable = GradientDrawable().apply { cornerRadius = 18f }
+        assertEquals(18f, Api23UiCompat.cornerRadius(drawable), 0.01f)
+    }
+}
diff --git a/common/src/test/java/com/shilapi/xcertplay/CarPlayBonjourBindConflictTest.kt b/common/src/test/java/com/shilapi/xcertplay/CarPlayBonjourBindConflictTest.kt
