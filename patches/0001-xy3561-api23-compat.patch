new file mode 100644
index 0000000000000000000000000000000000000000..47eb3426544537d62842c9775ea1535a30ae318f
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/Api23UiCompat.kt
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+package com.shilapi.xcertplay
+
+import android.content.res.Configuration
+import android.graphics.drawable.GradientDrawable
+import android.os.Build
+import java.util.Locale
+
+/** API23 equivalents kept outside the UI's business logic. */
+internal object Api23UiCompat {
+    @Suppress("DEPRECATION")
+    fun firstLocale(configuration: Configuration): Locale =
+        if (Build.VERSION.SDK_INT >= 24) configuration.locales[0] ?: Locale.getDefault()
+        else configuration.locale ?: Locale.getDefault()
+
+    @Suppress("DEPRECATION")
+    fun copyLocales(target: Configuration, source: Configuration) {
+        if (Build.VERSION.SDK_INT >= 24) target.setLocales(source.locales)
+        else target.setLocale(firstLocale(source))
+        target.setLayoutDirection(firstLocale(source))
+    }
+
+    fun cornerRadius(drawable: GradientDrawable): Float {
+        if (Build.VERSION.SDK_INT >= 24) return drawable.cornerRadius
+        // Android6's GradientState stores the value, but has no public getter.
+        return try {
+            val stateField = GradientDrawable::class.java.getDeclaredField("mGradientState").apply { isAccessible = true }
+            val state = stateField.get(drawable)
+            state.javaClass.getDeclaredField("mRadius").apply { isAccessible = true }.getFloat(state)
+        } catch (_: ReflectiveOperationException) { 0f }
+    }
+}
