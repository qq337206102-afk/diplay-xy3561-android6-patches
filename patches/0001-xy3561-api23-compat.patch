@@ -0,0 +1,41 @@
+package com.shilapi.xcertplay.orchestration
+
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import org.junit.Assert.*
+import org.junit.Test
+
+class ControllerTeardownGateTest {
+    @Test fun emptyGateIsReady() { assertTrue(ControllerTeardownGate().await(0)) }
+    @Test fun unfinishedClosePreventsRestartAndIsNotForgottenOnTimeout() {
+        val gate = ControllerTeardownGate()
+        val token = gate.begin()
+        assertFalse(gate.await(1))
+        assertFalse(gate.await(0))
+        gate.complete(token)
+        assertTrue(gate.await(0))
+    }
+    @Test fun allOldOwnersMustFinish() {
+        val gate = ControllerTeardownGate()
+        val a = gate.begin(); val b = gate.begin()
+        gate.complete(a)
+        assertFalse(gate.await(0))
+        gate.complete(b); gate.complete(b)
+        assertTrue(gate.await(0))
+    }
+    @Test fun waiterResumesAfterActualCompletion() {
+        val gate = ControllerTeardownGate()
+        val token = gate.begin()
+        val started = CountDownLatch(1)
+        val done = CountDownLatch(1)
+        var result = false
+        val worker = Thread { started.countDown(); result = gate.await(2_000); done.countDown() }
+        worker.start()
+        assertTrue(started.await(1, TimeUnit.SECONDS))
+        assertFalse(done.await(30, TimeUnit.MILLISECONDS))
+        gate.complete(token)
+        assertTrue(done.await(1, TimeUnit.SECONDS))
+        worker.join(1_000)
+        assertTrue(result)
+    }
+}
