+package com.shilapi.xcertplay.network
+
+import java.net.InetAddress
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class LegacyWirelessAddressesTest {
+    private val v4 = InetAddress.getByName("192.168.49.1")
+    private val v6 = InetAddress.getByName("fe80::1")
+    @Test fun api23UsesIpv4EvenWhenTheLastRetryPreferredIpv6() {
+        assertEquals(listOf(v4), legacyWirelessAddresses(listOf(v6, v4), 23))
+    }
+    @Test fun ipv6OnlyStillWorks() {
+        assertEquals(listOf(v6), legacyWirelessAddresses(listOf(v6), 23))
+    }
+    @Test fun modernDualStackIsUnchanged() {
+        assertEquals(listOf(v6, v4), legacyWirelessAddresses(listOf(v6, v4), 24))
+    }
+}
