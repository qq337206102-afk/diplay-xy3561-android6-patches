+package com.shilapi.xcertplay.network
+
+import java.net.Inet4Address
+import java.net.InetAddress
+
+/** Old Android multicast sockets can collide when JmDNS binds IPv4 and IPv6 together.
+ * Keep one known-working family on API23; do not erase IPv6-only networks. */
+internal fun legacyWirelessAddresses(addresses: List<InetAddress>, sdk: Int): List<InetAddress> {
+    if (sdk > 23) return addresses
+    val ipv4 = addresses.filterIsInstance<Inet4Address>()
+    return if (ipv4.isNotEmpty()) ipv4 else addresses
+}
