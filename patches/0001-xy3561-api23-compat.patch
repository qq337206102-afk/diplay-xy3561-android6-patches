index 0000000000000000000000000000000000000000..e7c7fb3ea9f94539933590b9304c660260af3394
--- /dev/null
+++ b/common/src/test/java/com/shilapi/xcertplay/CarPlayBonjourBindConflictTest.kt
@@ -0,0 +1,116 @@
+package com.shilapi.xcertplay
+
+import android.content.Context
+import android.net.nsd.NsdManager
+import android.net.nsd.NsdServiceInfo
+import android.net.wifi.WifiManager
+import com.shilapi.xcertplay.airplay.*
+import com.shilapi.xcertplay.network.CarPlayBonjour
+import java.io.IOException
+import java.net.BindException
+import java.net.DatagramSocket
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import javax.jmdns.JmDNS
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.ArgumentMatchers.*
+import org.mockito.Mockito.*
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [23], manifest = Config.NONE)
+class CarPlayBonjourBindConflictTest {
+    private val context = mock(Context::class.java)
+    private val wifi = mock(WifiManager::class.java)
+    private val lock = mock(WifiManager.MulticastLock::class.java)
+    private val nsd = mock(NsdManager::class.java)
+    private val address = InetAddress.getByName("192.0.2.10")
+    private val config = AirPlayConfig(deviceName="DiPlay", deviceId="02:00:00:00:00:02",
+        btMac="02:00:00:00:00:02",sourceVersion="366.0",main=AirPlayDisplayConfig(768,882))
+    private val identity = AirPlayIdentity(ByteArray(32),ByteArray(32),"test-pairing")
+    private val diagnostics = mutableListOf<String>()
+    private fun setup() {
+        `when`(context.applicationContext).thenReturn(context)
+        `when`(context.getSystemService(WifiManager::class.java)).thenReturn(wifi)
+        `when`(context.getSystemService(Context.NSD_SERVICE)).thenReturn(nsd)
+        `when`(wifi.createMulticastLock("carplay-bonjour")).thenReturn(lock)
+        `when`(lock.isHeld).thenReturn(true)
+    }
+    private fun client(extras: List<InetAddress> = emptyList()) = CarPlayBonjour(context,config,identity,
+        advertisedHost=address.hostAddress,useInterfaceMdns=true,additionalAddresses=extras,
+        onDiagnostic={diagnostics.add(it)})
+
+    @Test fun occupiedPortFallsBackWithoutClosingTheOtherOwnersSocket() {
+        setup()
+        // An actual held UDP socket, not just a fabricated success response.
+        DatagramSocket(null).use { owner ->
+            owner.reuseAddress=false
+            owner.bind(InetSocketAddress(InetAddress.getByName("127.0.0.1"),0))
+            val conflict = try {
+                DatagramSocket(null).use { contender ->
+                    contender.reuseAddress=false
+                    contender.bind(owner.localSocketAddress)
+                }
+                throw AssertionError("Expected a real bind conflict")
+            } catch (error: BindException) { error }
+            mockStatic(JmDNS::class.java).use { factory ->
+                factory.`when`<JmDNS> { JmDNS.create(address,"carplay-020000000002") }.thenThrow(conflict)
+                client().use { bonjour ->
+                    bonjour.start(); bonjour.start()
+                    assertTrue(bonjour.diagnosticSnapshot().contains("discoveryBackend=system_nsd"))
+                    verify(nsd,times(1)).registerService(any(NsdServiceInfo::class.java),eq(NsdManager.PROTOCOL_DNS_SD),any(NsdManager.RegistrationListener::class.java))
+                    verify(nsd,times(1)).discoverServices(eq("_carplay-ctrl._tcp"),eq(NsdManager.PROTOCOL_DNS_SD),any(NsdManager.DiscoveryListener::class.java))
+                    assertFalse(owner.isClosed)
+                }
+                verify(nsd).unregisterService(any(NsdManager.RegistrationListener::class.java))
+                verify(nsd).stopServiceDiscovery(any(NsdManager.DiscoveryListener::class.java))
+                assertFalse(owner.isClosed)
+                assertTrue(diagnostics.any { it.contains("udpPort=5353; fallback=system_nsd") })
+            }
+        }
+    }
+    @Test fun unrelatedIoFailureDoesNotSilentlyChangeBackend() {
+        setup()
+        mockStatic(JmDNS::class.java).use { factory ->
+            factory.`when`<JmDNS> { JmDNS.create(address,"carplay-020000000002") }.thenThrow(IOException("network down"))
+            try { client().use { it.start() }; fail("must propagate") } catch (_: IOException) { }
+            verifyNoInteractions(nsd)
+            verify(lock).release()
+        }
+    }
+    @Test fun permissionDeniedIsNotMistakenForPortOccupancy() {
+        setup()
+        mockStatic(JmDNS::class.java).use { factory ->
+            factory.`when`<JmDNS> { JmDNS.create(address,"carplay-020000000002") }.thenThrow(BindException("Permission denied"))
