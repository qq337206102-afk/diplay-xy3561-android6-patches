@@ -0,0 +1,36 @@
+package com.shilapi.xcertplay.network
+
+import java.io.IOException
+import java.net.BindException
+import java.net.SocketException
+import org.junit.Assert.*
+import org.junit.Test
+
+class MdnsPortDiagnosticsTest {
+    @Test fun onlyAddressInUseTriggersRecovery() {
+        assertTrue(mdnsAddressInUse(BindException("Address already in use: bind")))
+        assertTrue(mdnsAddressInUse(IOException("outer", SocketException("bind failed: EADDRINUSE"))))
+        assertFalse(mdnsAddressInUse(BindException("Permission denied")))
+        assertFalse(mdnsAddressInUse(BindException("Cannot assign requested address")))
+        assertFalse(mdnsAddressInUse(IOException("Address already in use but not a socket error")))
+        assertFalse(mdnsAddressInUse(SecurityException("permission")))
+    }
+    @Test fun procParserRetainsOnlyMdnsOwnerNotAddressesOrOtherPorts() {
+        val lines = listOf(
+            "sl local_address rem_address st tx_queue rx_queue tr tm->when retrnsmt uid timeout inode",
+            " 0: 00000000:14E9 00000000:0000 07 00000000:00000000 00:00000000 00000000 1000 0 45678 2",
+            " 1: 0101A8C0:1B58 0201A8C0:0123 07 00000000:00000000 00:00000000 00000000 10123 0 98765 2",
+        )
+        assertEquals("uid=1000/inode=45678", MdnsPortDiagnostics.owners(lines))
+        assertEquals("no_visible_owner", MdnsPortDiagnostics.owners(emptyList()))
+        assertEquals("no_visible_owner", MdnsPortDiagnostics.owners(listOf("malformed")))
+    }
+    @Test fun packageLookupIsLimitedToMdnsOwnersAndFiltersUnexpectedText() {
+        val uids = mutableListOf<Int>()
+        val row="0: 00000000:14E9 00000000:0000 07 00000000:00000000 00:00000000 00000000 10123 0 45678 2"
+        assertEquals("uid=10123/inode=45678/packages=com.example.mdns", MdnsPortDiagnostics.owners(listOf(row)) {
+            uids.add(it); listOf("com.example.mdns", "bad\ntext")
+        })
+        assertEquals(listOf(10123), uids)
+    }
+}
