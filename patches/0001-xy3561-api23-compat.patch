index 0000000000000000000000000000000000000000..8d1f72a8aa03b814619508eadf6f2b53b67fe13d
--- /dev/null
+++ b/shared/src/main/java/com/shilapi/xcertplay/orchestration/ControllerTeardownGate.kt
@@ -0,0 +1,31 @@
+package com.shilapi.xcertplay.orchestration
+
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+/** Process-wide handoff between Activity instances. A new host must not reuse the old radio stack
+ * merely because the old Activity has disappeared or its UI wait budget expired. */
+internal class ControllerTeardownGate {
+    private val pending = mutableSetOf<CountDownLatch>()
+
+    @Synchronized fun begin(): CountDownLatch = CountDownLatch(1).also { pending.add(it) }
+
+    @Synchronized fun complete(token: CountDownLatch) {
+        pending.remove(token)
+        token.countDown()
+    }
+
+    fun await(timeoutMillis: Long): Boolean {
+        require(timeoutMillis >= 0)
+        val deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(timeoutMillis)
+        while (true) {
+            val snapshot = synchronized(this) { pending.toList() }
+            if (snapshot.isEmpty()) return true
+            for (token in snapshot) {
+                if (!token.await((deadline - System.nanoTime()).coerceAtLeast(0), TimeUnit.NANOSECONDS)) return false
+            }
+        }
+    }
+
+    companion object { val process = ControllerTeardownGate() }
+}
