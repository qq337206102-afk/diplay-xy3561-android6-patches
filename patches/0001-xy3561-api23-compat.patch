new file mode 100644
index 0000000000000000000000000000000000000000..2d30a4828d82a24d15274c4ccc14a8613d0b6c8c
--- /dev/null
+++ b/shared/src/main/java/com/shilapi/xcertplay/network/MdnsPortDiagnostics.kt
@@ -0,0 +1,40 @@
+package com.shilapi.xcertplay.network
+
+import android.content.Context
+import java.io.File
+import java.net.SocketException
+
+internal fun mdnsAddressInUse(error: Throwable): Boolean =
+    generateSequence(error) { it.cause }.take(8).any {
+        it is SocketException &&
+            (it.message.orEmpty().contains("EADDRINUSE") ||
+                it.message.orEmpty().contains("Address already in use", ignoreCase = true))
+    }
+
+/** Read only the mDNS port's UID/inode, never IP addresses or unrelated socket entries.
+ * Modern Android may deny procfs; missing evidence remains unknown, not 'port is free'. */
+internal object MdnsPortDiagnostics {
+    fun snapshot(context: Context? = null): String = listOf("udp", "udp6").joinToString(" ") { family ->
+        val lines = runCatching { File("/proc/net/$family").readLines() }.getOrNull()
+        if (lines == null) "$family=unreadable" else "$family=${owners(lines) { uid ->
+            runCatching { context?.packageManager?.getPackagesForUid(uid)?.toList().orEmpty() }.getOrDefault(emptyList())
+        }}"
+    }
+
+    internal fun owners(lines: List<String>, packagesForUid: (Int) -> List<String> = { emptyList() }): String {
+        val owners = lines.mapNotNull { line ->
+            val fields = line.trim().split(Regex("\\s+"))
+            if (fields.size < 10 || fields[1].substringAfterLast(':').toIntOrNull(16) != 5353) null
+            else {
+                val uid = fields[7].toIntOrNull()
+                val inode = fields[9].toLongOrNull()
+                if (uid == null || inode == null) null else {
+                    val packages = packagesForUid(uid).filter { it.matches(Regex("[A-Za-z0-9_.]+")) }
+                        .distinct().take(4).joinToString("+")
+                    "uid=$uid/inode=$inode" + if (packages.isEmpty()) "" else "/packages=$packages"
+                }
+            }
+        }.distinct().take(8)
+        return if (owners.isEmpty()) "no_visible_owner" else owners.joinToString(",")
+    }
+}
